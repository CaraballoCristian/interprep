# Path to the SQLite database file. Relative paths resolve from the project root.
DATABASE_PATH=./data/app.db

# Public URL of the app. Must match the Google OAuth redirect URI host.
# Local: http://localhost:3000
# Production: https://your-domain.example
BETTER_AUTH_URL=http://localhost:3000

# Random secret with at least 32 characters. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-chars

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional secret dedicated to encrypting per-user secrets (Gemini API keys).
# Falls back to BETTER_AUTH_SECRET when empty. Rotating it requires users to
# re-enter their keys. Generate one with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Gemini model used by Dictado. Each user supplies their own API key in the UI.
GEMINI_MODEL=gemini-2.5-flash

# Optional comma-separated allowlist. Empty means anyone with Google can sign up.
# Example: ALLOWED_EMAILS=me@example.com,friend@example.com
ALLOWED_EMAILS=

# Host port used by docker-compose (defaults to 3000). Not used by Dokploy.
APP_PORT=3000
